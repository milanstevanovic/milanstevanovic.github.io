---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import SocialIcons from '../components/SocialIcons.astro';
import { getPosts } from '../lib/posts';
import { SITE } from '../site';

const posts = await getPosts();
---

<Base>
  <section class="mb-12">
    <h1 class="text-4xl font-bold tracking-tight">{SITE.name}</h1>
    <div class="mt-3 text-lg text-muted">
      {SITE.roleLines.map((line) => <p>{line}</p>)}
    </div>
    <div class="mt-5">
      <SocialIcons />
    </div>
  </section>

  <section aria-label="Posts" class="space-y-8">
    {posts.map((post, i) => <PostCard post={post} eager={i === 0} />)}
  </section>
</Base>
