---
import { Image } from 'astro:assets';
import Base from './Base.astro';
import { formatDate, readingTime, type Post } from '../lib/posts';

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { title, description, date, cover } = post.data;
---

<Base title={title} description={description} image={cover.image} type="article" published={date}>
  <article>
    <header>
      <h1 class="text-3xl font-bold leading-tight tracking-tight sm:text-4xl">{title}</h1>
      <p class="mt-3 text-sm text-muted">
        <time datetime={date.toISOString()}>{formatDate(date)}</time> · {readingTime(post.body)} min
      </p>
    </header>

    <figure class="mt-8">
      <Image
        src={cover.image}
        alt={cover.alt}
        width={672}
        sizes="(min-width: 42rem) 672px, 100vw"
        class="w-full rounded-xl"
        loading="eager"
        fetchpriority="high"
      />
      {cover.caption && <figcaption class="mt-2 text-center text-sm text-muted">{cover.caption}</figcaption>}
    </figure>

    <div class="prose-site mt-8">
      <slot />
    </div>
  </article>

  {
    (newer || older) && (
      <nav class="no-print mt-12 grid gap-4 border-t border-line pt-6 sm:grid-cols-2" aria-label="More posts">
        {newer ? (
          <a href={`/posts/${newer.id}/`} class="group block no-underline">
            <span class="text-sm text-muted">« Prev</span>
            <span class="mt-1 block font-medium group-hover:underline">{newer.data.title}</span>
          </a>
        ) : (
          <span />
        )}
        {older && (
          <a href={`/posts/${older.id}/`} class="group block no-underline sm:text-right">
            <span class="text-sm text-muted">Next »</span>
            <span class="mt-1 block font-medium group-hover:underline">{older.data.title}</span>
          </a>
        )}
      </nav>
    )
  }
</Base>
