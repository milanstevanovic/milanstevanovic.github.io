---
import { FOOTER } from '../site';

const year = new Date().getFullYear();
---

<footer class="no-print border-t border-line">
  <p class="mx-auto max-w-content px-5 py-6 text-sm text-muted">
    {`© ${year} ${FOOTER.owner} · `}
    <a href={FOOTER.company.href} class="underline hover:text-ink">{FOOTER.company.name}</a>
    {` (${FOOTER.company.details})`}
  </p>
</footer>
