---
import { NAV, SITE } from '../site';

const path = Astro.url.pathname;
---

<header class="no-print border-b border-line">
  <nav class="mx-auto flex max-w-content flex-wrap items-center justify-between gap-x-6 gap-y-2 px-5 py-4">
    <a href="/" class="font-semibold no-underline hover:underline">{SITE.name}</a>
    <ul class="flex flex-wrap gap-x-5 gap-y-1 text-sm">
      {
        NAV.map(({ label, href }) => (
          <li>
            <a
              href={href}
              class:list={[
                'no-underline hover:underline',
                path.startsWith(href) ? 'text-ink font-medium' : 'text-muted',
              ]}
              aria-current={path.startsWith(href) ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
