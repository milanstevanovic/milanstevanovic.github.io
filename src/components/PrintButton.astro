<div class="no-print mb-6 flex justify-end">
  <button
    type="button"
    data-print
    class="rounded-md border border-line px-4 py-2 text-sm font-medium hover:bg-surface focus:outline-none focus:ring-2 focus:ring-accent"
  >
    Print / Save as PDF
  </button>
</div>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>
