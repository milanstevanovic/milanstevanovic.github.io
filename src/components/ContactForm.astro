---
import { CONTACT_FORM_ACTION } from '../site';

const field = 'mt-1 block w-full rounded-md border border-line bg-page px-3 py-2 text-ink focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent';
---

<form action={CONTACT_FORM_ACTION} method="POST" class="mt-8 space-y-4">
  <div>
    <label for="name" class="text-sm font-medium">Name</label>
    <input type="text" id="name" name="name" autocomplete="name" required class={field} />
  </div>
  <div>
    <label for="email" class="text-sm font-medium">Email</label>
    <input type="email" id="email" name="email" autocomplete="email" required class={field} />
  </div>
  <div>
    <label for="message" class="text-sm font-medium">Message</label>
    <textarea id="message" name="message" rows="5" required class:list={[field, 'resize-y']}></textarea>
  </div>
  <button
    type="submit"
    class="rounded-md bg-ink px-5 py-2.5 font-medium text-page hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2"
  >
    Send Message
  </button>
</form>
